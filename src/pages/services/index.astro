---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import CtaBand from '../../components/CtaBand.astro';
import Icon from '../../components/Icon.astro';
import { services, comparison } from '../../data/services';
import { waLink } from '../../config/site';
---

<BaseLayout
  title="שירותים"
  description="אתרי תדמית, חנויות אונליין, דפי נחיתה ותחזוקה שוטפת. מה כלול בכל סוג פרויקט, למי הוא מתאים וכמה זמן הוא לוקח."
>
  <PageHero
    eyebrow="שירותים"
    title="ארבע דרכים לעזור לעסק שלך למכור יותר"
    lead="לכל שירות: למי הוא מתאים, מה בדיוק כלול וכמה זמן הוא לוקח. בלי כוכביות."
  />

  {
    services.map((service, i) => (
      <section class="section service-block" id={service.slug}>
        <div class="container">
          <div class="service-block__grid reveal">
            <div class="service-block__intro">
              <span class="service-block__icon" aria-hidden="true">
                <Icon name={service.icon} size={24} />
              </span>
              <p class="eyebrow">{String(i + 1).padStart(2, '0')}</p>
              <h2>{service.title}</h2>
              <p class="lead">{service.short}</p>

              <div class="service-block__who">
                <h3>למי זה מתאים</h3>
                <p>{service.forWho}</p>
              </div>

              <dl class="service-block__meta">
                <div>
                  <dt>זמן אספקה</dt>
                  <dd>{service.timeline}</dd>
                </div>
                <div>
                  <dt>מה משפיע על המחיר</dt>
                  <dd>{service.startingNote}</dd>
                </div>
              </dl>
            </div>

            <div class="card service-block__includes">
              <h3>מה כלול</h3>
              <ul>
                {service.includes.map((item) => (
                  <li>
                    <Icon name="check" size={17} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <div class="btn-row service-block__actions">
                <a class="btn btn--primary" href="/contact">
                  קבלת הצעת מחיר
                  <Icon name="arrow" size={16} />
                </a>
                <a
                  class="btn btn--outline"
                  href={waLink(`היי, אשמח לשמוע פרטים על ${service.title}`)}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  <Icon name="whatsapp" size={16} />
                  שאלה מהירה
                </a>
              </div>
              <p class="service-block__link">
                <a class="link-arrow" href={`/services/${service.slug}`}>
                  עמוד מלא על {service.title}
                  <Icon name="arrow" size={15} />
                </a>
              </p>
            </div>
          </div>
        </div>
      </section>
    ))
  }

  <!-- Comparison table -->
  <section class="section section--soft">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">השוואה מהירה</p>
        <h2>מה כלול בכל סוג פרויקט</h2>
        <p class="lead">טבלה אחת שמסכמת את ההבדלים. גוללים לצדדים במסך קטן.</p>
      </div>

      <div class="table-wrap reveal">
        <table class="compare">
          <caption class="sr-only">השוואת שירותים לפי מה שכלול בכל אחד</caption>
          <thead>
            <tr>
              <th scope="col">מה כלול</th>
              {services.map((s) => <th scope="col">{s.title}</th>)}
            </tr>
          </thead>
          <tbody>
            {
              comparison.rows.map((row) => (
                <tr>
                  <th scope="row">{row.feature}</th>
                  {row.values.map((v) => (
                    <td class:list={{ 'is-yes': v === '✓', 'is-no': v === '—' }}>
                      {v === '✓' ? <Icon name="check" size={18} title="כלול" /> : v}
                    </td>
                  ))}
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <CtaBand />
</BaseLayout>

<style>
  .service-block + .service-block {
    border-top: 1px solid var(--c-border);
  }

  .service-block__grid {
    display: grid;
    gap: var(--space-5);
    align-items: start;
  }

  .service-block__icon {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    border-radius: var(--radius);
    background: var(--c-accent-soft);
    color: var(--c-accent);
    margin-bottom: var(--space-3);
  }

  .service-block__intro h2 {
    margin-bottom: var(--space-2);
  }

  .service-block__who {
    margin-top: var(--space-4);
    padding-inline-start: var(--space-3);
    border-inline-start: 3px solid var(--c-gold);
  }

  .service-block__who h3 {
    font-family: var(--font-sans);
    font-size: var(--fs-xs);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
    margin-bottom: 0.3rem;
  }

  .service-block__who p {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  .service-block__meta {
    display: grid;
    gap: var(--space-3);
    margin: var(--space-4) 0 0;
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-border);
  }

  .service-block__meta dt {
    font-size: var(--fs-xs);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--c-ink-muted);
  }

  .service-block__meta dd {
    margin: 0.2rem 0 0;
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  .service-block__includes {
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-bg-soft);
  }

  .service-block__includes h3 {
    font-size: var(--fs-md);
    margin-bottom: var(--space-3);
  }

  .service-block__includes ul {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--space-4);
    display: grid;
    gap: 0.65rem;
    font-size: var(--fs-sm);
  }

  .service-block__includes li {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
  }

  .service-block__includes :global(li svg) {
    color: var(--c-gold);
    flex-shrink: 0;
    margin-top: 0.2rem;
  }

  .service-block__link {
    margin-top: var(--space-3);
  }

  /* --- Table -------------------------------------------------------- */
  .table-wrap {
    overflow-x: auto;
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
    background: var(--c-bg);
  }

  .compare {
    width: 100%;
    min-width: 640px;
    border-collapse: collapse;
    font-size: var(--fs-sm);
  }

  .compare th,
  .compare td {
    padding: 0.9rem 1rem;
    text-align: start;
    border-bottom: 1px solid var(--c-border);
  }

  .compare thead th {
    background: var(--c-accent);
    color: #fff;
    font-family: var(--font-serif);
    font-weight: 600;
    white-space: nowrap;
  }

  .compare tbody th {
    font-weight: 600;
    background: var(--c-bg-soft);
  }

  .compare td {
    text-align: center;
    color: var(--c-ink-soft);
  }

  .compare td.is-yes :global(svg) {
    margin-inline: auto;
    color: var(--c-success);
  }

  .compare td.is-no {
    color: var(--c-border-strong);
  }

  .compare tbody tr:last-child th,
  .compare tbody tr:last-child td {
    border-bottom: 0;
  }

  .section-head {
    margin-bottom: var(--space-5);
    max-width: 68ch;
  }

  .section-head .lead {
    margin-top: var(--space-2);
  }

  @media (min-width: 900px) {
    .service-block__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
  }
</style>
