---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import TestimonialCard from '../components/TestimonialCard.astro';
import CtaBand from '../components/CtaBand.astro';
import { testimonials } from '../data/content';
import { site } from '../config/site';

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: testimonials.map((t, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      item: {
        '@type': 'Review',
        reviewBody: t.quote,
        author: { '@type': 'Person', name: t.name },
        itemReviewed: { '@type': 'ProfessionalService', name: site.nameHe },
      },
    })),
  },
];
---

<BaseLayout
  title="המלצות לקוחות"
  description="מה לקוחות אומרים על העבודה איתי: מה עבד, כמה זמן זה לקח, ומה השתנה בעסק אחרי שהאתר עלה."
  schema={schema}
>
  <PageHero
    eyebrow="המלצות"
    title="מה לקוחות אומרים"
    lead="מה אומרים לקוחות שכבר עברו את התהליך."
  />

  <section class="section">
    <div class="container">
      <div class="masonry">
        {
          testimonials.map((t, i) => (
            <TestimonialCard
              quote={t.quote}
              name={t.name}
              business={t.business}
              delay={i * 60}
            />
          ))
        }
      </div>
    </div>
  </section>

  <CtaBand
    title="רוצים להיות ההמלצה הבאה?"
    text="ספרו לי מה העסק שלכם צריך. שיחת היכרות של 30 דקות, בחינם ובלי התחייבות."
  />
</BaseLayout>

<style>
  /* Flex rather than grid so a partial last row centres itself instead of
     hugging one edge. Cards are capped at a fraction of the row so full rows
     still line up on a strict column grid. */
  .masonry {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
    align-items: stretch;
  }

  .masonry > :global(*) {
    flex: 1 1 280px;
    max-width: 100%;
  }

  @media (min-width: 700px) {
    .masonry > :global(*) {
      max-width: calc((100% - var(--space-4)) / 2);
    }
  }

  @media (min-width: 1024px) {
    .masonry > :global(*) {
      max-width: calc((100% - 2 * var(--space-4)) / 3);
    }
  }
</style>
