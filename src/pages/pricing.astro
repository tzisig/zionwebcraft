---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { pricingFactors } from '../data/content';
import { waLink } from '../config/site';
---

<BaseLayout
  title="בניית אתרים מחיר"
  description="כמה עולה לבנות אתר לעסק? מה משפיע על המחיר, למה אין כאן מחירון, ואיך מקבלים הצעת מחיר מותאמת בחינם ובלי התחייבות."
>
  <PageHero
    eyebrow="מחירים"
    title="כמה עולה לבנות אתר? תלוי בארבעה דברים"
    lead="כמה עולה רכב? תלוי איזה. עם אתרים זה בדיוק אותו דבר. בלי לדעת מה האתר צריך לעשות, כל מספר שאתן לכם יהיה חתול בשק, ולכן אין כאן מחירון."
  >
    <div class="btn-row hero-actions">
      <a class="btn btn--primary" href="#quote">
        לקבלת הצעת מחיר
        <Icon name="arrow" size={16} />
      </a>
      <a class="btn btn--outline" href={waLink()} target="_blank" rel="noopener noreferrer">
        <Icon name="whatsapp" size={16} />
        לשאול משהו קצר
      </a>
    </div>
  </PageHero>

  <section class="section">
    <div class="container">
      <div class="section-head reveal">
        <p class="eyebrow">מה משפיע על העלות</p>
        <h2>ארבעה גורמים שקובעים את המחיר</h2>
        <p class="lead">
          כשאני מכין הצעת מחיר, אלה הדברים שאני בודק. אם תדעו מראש מה מהם רלוונטי אצלכם, גם
          השיחה הראשונה תהיה קצרה ומדויקת יותר.
        </p>
      </div>

      <div class="grid grid--2">
        {
          pricingFactors.map((f, i) => (
            <article class="card factor reveal" data-reveal-delay={i * 70}>
              <span class="factor__n" aria-hidden="true">
                {String(i + 1).padStart(2, '0')}
              </span>
              <h3>{f.title}</h3>
              <p>{f.text}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <p class="eyebrow">איך מקבלים מחיר אמיתי</p>
        <h2>מהשיחה הראשונה להצעה בכתב, תוך יומיים</h2>
      </div>

      <ol class="how reveal">
        <li>
          <strong>שיחת היכרות של 30 דקות</strong>
          <span>בחינם. מבינים מה העסק צריך, ומה האתר צריך לעשות בשבילו.</span>
        </li>
        <li>
          <strong>הצעת מחיר בכתב</strong>
          <span>תוך יומיים: מה כלול, מה לא, לוח זמנים ותנאי תשלום. בחינם ובלי התחייבות.</span>
        </li>
        <li>
          <strong>תשלום לפי שלבים</strong>
          <span>אפשר לשלם בתשלומים לפי שלבי הפרויקט. הפירוט המדויק מופיע בהצעת המחיר.</span>
        </li>
      </ol>

      <p class="disclaimer reveal">
        <Icon name="sparkle" size={16} />
        <span>
          המחירים שלי אטרקטיביים, אבל אני לא אמכור לכם משהו שאתם לא צריכים. ואם התקציב שלכם
          קטן ממה שהפרויקט דורש, אגיד לכם את זה ישר.
        </span>
      </p>
    </div>
  </section>

  <section class="section" id="quote">
    <div class="container container--narrow">
      <div class="section-head reveal">
        <p class="eyebrow">הצעת מחיר</p>
        <h2>ספרו לי מה אתם צריכים, ואחזור עם הצעה</h2>
        <p class="lead">
          בחינם ובלי התחייבות. אחזור אליכם תוך יום עסקים, בלי שיחות מכירה חוזרות.
        </p>
      </div>
      <div class="card form-card reveal">
        <ContactForm sourceLabel="pricing" />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-actions {
    margin-top: var(--space-4);
  }

  .section-head {
    margin-bottom: var(--space-5);
    max-width: 66ch;
  }

  .section-head .lead {
    margin-top: var(--space-2);
  }

  .factor__n {
    display: block;
    font-family: var(--font-serif);
    font-size: var(--fs-sm);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--c-gold);
    margin-bottom: 0.5rem;
  }

  .factor h3 {
    font-size: var(--fs-md);
    margin-bottom: 0.5rem;
  }

  .factor p {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  .how {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0;
    counter-reset: how;
    background: var(--c-bg);
    border: 1px solid var(--c-border);
    border-radius: var(--radius-lg);
  }

  .how li {
    display: grid;
    gap: 0.25rem;
    padding: var(--space-3) var(--space-4);
    counter-increment: how;
    position: relative;
  }

  .how li + li {
    border-top: 1px solid var(--c-border);
  }

  .how li::before {
    content: counter(how);
    position: absolute;
    inset-inline-end: var(--space-4);
    top: var(--space-3);
    font-family: var(--font-serif);
    font-size: 1.5rem;
    color: var(--c-border-strong);
  }

  .how strong {
    font-family: var(--font-serif);
    font-size: var(--fs-md);
  }

  .how span {
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
    max-width: 60ch;
  }

  .disclaimer {
    display: flex;
    gap: 0.6rem;
    align-items: flex-start;
    margin-top: var(--space-4);
    font-size: var(--fs-sm);
    color: var(--c-ink-soft);
  }

  .disclaimer :global(svg) {
    color: var(--c-gold);
    flex-shrink: 0;
    margin-top: 0.25rem;
  }

  .form-card {
    padding: clamp(1.25rem, 3vw, 2.25rem);
  }
</style>
