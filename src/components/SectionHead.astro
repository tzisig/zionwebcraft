---
interface Props {

  eyebrow?: string;
  title: string;
  lead?: string;
  align?: 'start' | 'center';
  as?: 'h2' | 'h3';
}

const { eyebrow, title, lead, align = 'start', as: Tag = 'h2' }: Props = Astro.props;
---

<div class:list={['section-head', `section-head--${align}`, 'reveal']}>
  {eyebrow && <p class="eyebrow">{eyebrow}</p>}
  <Tag>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
</div>

<style>
  .section-head {
    margin-bottom: var(--space-5);
    max-width: 68ch;
  }

  .section-head--center {
    margin-inline: auto;
    text-align: center;
  }

  .section-head--center :global(.eyebrow) {
    justify-content: center;
  }

  .section-head--center :global(.lead) {
    margin-inline: auto;
  }

  .section-head :global(.lead) {
    margin-top: var(--space-2);
  }
</style>
