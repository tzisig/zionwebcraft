---
import Icon from './Icon.astro';

interface Props {
  quote: string;
  name: string;
  business: string;
  delay?: number;
}

const { quote, name, business, delay = 0 } = Astro.props;
const initials = name.split(' ').map((w) => w.charAt(0)).slice(0, 2).join('');
---

<figure class="card testimonial reveal" data-reveal-delay={delay}>
  <Icon name="quote" size={26} class="testimonial__mark" />
  <blockquote class="testimonial__quote">{quote}</blockquote>
  <figcaption class="testimonial__author">
    <span class="testimonial__avatar" aria-hidden="true">{initials}</span>
    <span>
      <strong>{name}</strong>
      <span class="testimonial__business">{business}</span>
    </span>
  </figcaption>
</figure>

<style>
  .testimonial {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }

  .testimonial :global(.testimonial__mark) {
    color: var(--c-gold);
    opacity: 0.75;
  }

  .testimonial__quote {
    margin: 0;
    font-family: var(--font-serif);
    font-size: var(--fs-md);
    line-height: 1.6;
    flex: 1;
  }

  .testimonial__author {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding-top: var(--space-3);
    border-top: 1px solid var(--c-border);
    font-size: var(--fs-sm);
  }

  .testimonial__avatar {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    flex-shrink: 0;
    border-radius: 999px;
    background: var(--c-accent-soft);
    color: var(--c-accent);
    font-weight: 700;
  }

  .testimonial__author strong {
    display: block;
    line-height: 1.3;
  }

  .testimonial__business {
    color: var(--c-ink-muted);
    font-size: var(--fs-xs);
  }
</style>
