---
import { waLink } from '../config/site';
import Icon from './Icon.astro';
---

<a
  class="wa-float"
  href={waLink()}
  target="_blank"
  rel="noopener noreferrer"
  data-track="whatsapp-float"
>
  <Icon name="whatsapp" size={26} title="פתיחת שיחת וואטסאפ" />
  <span class="wa-float__label">דברו איתי</span>
</a>

<style>
  .wa-float {
    position: fixed;
    inset-block-end: clamp(1rem, 3vw, 1.75rem);
    inset-inline-start: clamp(1rem, 3vw, 1.75rem);
    z-index: 90;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 56px;
    padding: 0 1.15rem;
    border-radius: 999px;
    background: #1f7a4d;
    color: #fff;
    text-decoration: none;
    font-size: var(--fs-sm);
    font-weight: 600;
    box-shadow: 0 10px 28px -10px rgba(31, 122, 77, 0.65);
    transition:
      transform var(--dur) var(--ease),
      background-color var(--dur) var(--ease);
  }

  .wa-float:hover {
    background: #196540;
    transform: translateY(-2px);
  }

  @media (max-width: 600px) {
    .wa-float {
      min-width: 56px;
      padding: 0 1rem;
    }

    .wa-float__label {
      display: none;
    }
  }
</style>
